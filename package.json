{
  "name": "localflow",
  "version": "0.1.0",
  "description": "Run CI/CD pipeline jobs locally using Docker",
  "type": "module",
  "bin": {
    "localflow": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dockerode": "^4.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.29",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "vitest": {
    "environment": "node",
    "include": ["tests/**/*.test.ts"]
  }
}
